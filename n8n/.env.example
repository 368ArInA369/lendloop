# Copy to n8n/.env before `docker compose up -d`. Never commit the real file.

# Random 32+ chars; encrypts credentials stored by n8n. Generate once and keep.
N8N_ENCRYPTION_KEY=

# Shared secret for HMAC signatures in both directions. Must equal the
# N8N_WEBHOOK_SECRET set on the Convex deployment. 32+ random chars.
LENDLOOP_WEBHOOK_SECRET=

# Convex HTTP actions URL (from `npx convex dev` output / .env.local
# NEXT_PUBLIC_CONVEX_SITE_URL), e.g. https://happy-animal-123.convex.site
# When n8n runs in Docker and Convex runs locally use http://host.docker.internal:3211
CONVEX_SITE_URL=

# "email" sends real mail through the "LendLoop SMTP" credential configured in n8n;
# "mock" only logs the notification in the execution output (fine for review).
LENDLOOP_NOTIFY_VIA=mock
LENDLOOP_FROM_EMAIL=lendloop@example.com
LENDLOOP_OPS_EMAIL=ops@example.com

# Public base URL of n8n, used to build webhook URLs (ngrok/Cloudflare tunnel
# when Convex cloud needs to reach your laptop).
N8N_PUBLIC_URL=http://localhost:5678
TZ=Europe/Madrid
