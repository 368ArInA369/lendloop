# Copy to .env.local (git-ignored). Values marked (Convex) are NOT read from this
# file: set them on the deployment with `npx convex env set NAME value`.

# --- Next.js / Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Convex (written automatically by `npx convex dev`) ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# --- Convex deployment variables (Convex) ---
# CLERK_JWT_ISSUER_DOMAIN   https://<your-app>.clerk.accounts.dev  (Clerk JWT template "convex")
# N8N_WEBHOOK_SECRET        32+ random chars, same value as LENDLOOP_WEBHOOK_SECRET in n8n/.env
# N8N_REQUEST_WEBHOOK_URL   http://localhost:5678/webhook/lendloop-request (or your tunnel URL)
# ADMIN_EMAILS              comma-separated emails that become admin on sign-in (optional)
